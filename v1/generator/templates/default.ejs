<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= meta.title %> | <%= settings.siteTitle %></title>
  <meta name="description" content="<%= meta.description %>">
  <% if (meta.keywords) { %>
  <meta name="keywords" content="<%= meta.keywords %>">
  <% } %>
  
  <!-- Favicon -->
  <% if (settings.favicon) { %>
  <link rel="icon" href="<%= settings.favicon %>">
  <% } %>
  
  <!-- Styles -->
  <link rel="stylesheet" href="/assets/css/theme.css">
  
  <!-- Police de caractères -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <% 
  const fontFamilies = [];
  if (theme.fonts.body) fontFamilies.push(theme.fonts.body.split(',')[0]);
  if (theme.fonts.heading && theme.fonts.heading !== theme.fonts.body) fontFamilies.push(theme.fonts.heading.split(',')[0]);
  const googleFonts = fontFamilies
    .filter(font => !font.includes('serif') && !font.includes('Arial') && !font.includes('Helvetica'))
    .map(font => font.trim().replace(/\s+/g, '+'))
    .join('&family=');
  %>
  <% if (googleFonts) { %>
  <link href="https://fonts.googleapis.com/css2?family=<%= googleFonts %>:wght@400;500;700&display=swap" rel="stylesheet">
  <% } %>
</head>
<body>
  <!-- En-tête -->
  <header class="site-header">
    <div class="container">
      <div class="header-content">
        <% if (settings.logo) { %>
        <a href="/" class="logo">
          <img src="<%= settings.logo %>" alt="<%= settings.siteTitle %>">
        </a>
        <% } else { %>
        <a href="/" class="site-title"><%= settings.siteTitle %></a>
        <% } %>
        
        <!-- Navigation -->
        <nav class="main-nav">
          <ul>
            <li><a href="/">Accueil</a></li>
            <li><a href="/a-propos.html">À propos</a></li>
            <li><a href="/services.html">Services</a></li>
            <li><a href="/blog.html">Blog</a></li>
            <li><a href="/contact.html">Contact</a></li>
          </ul>
        </nav>
        
        <!-- Bouton menu mobile -->
        <button class="menu-toggle" aria-label="Menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>
  </header>

  <!-- Contenu principal -->
  <main class="site-main">
    <% if (page.title) { %>
    <div class="page-header">
      <div class="container">
        <h1><%= page.title %></h1>
        <% if (page.description) { %>
        <p class="page-description"><%= page.description %></p>
        <% } %>
      </div>
    </div>
    <% } %>
    
    <!-- Blocs de contenu -->
    <div class="page-content">
      <div class="container">
        <% if (blocks.length === 0) { %>
          <p>Aucun contenu n'a été ajouté à cette page.</p>
        <% } else { %>
          <% blocks.forEach(block => { %>
            <div class="content-block block-<%= block.type %>" id="<%= block.id %>" <%= block.styleAttr %> <%= block.animationAttr %>>
              <%- block.processedContent %>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>
  </main>

  <!-- Pied de page -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-content">
        <div class="footer-info">
          <h3><%= settings.siteTitle %></h3>
          <p><%= settings.siteDescription %></p>
        </div>
        
        <div class="footer-links">
          <h4>Liens rapides</h4>
          <ul>
            <li><a href="/">Accueil</a></li>
            <li><a href="/a-propos.html">À propos</a></li>
            <li><a href="/services.html">Services</a></li>
            <li><a href="/blog.html">Blog</a></li>
            <li><a href="/contact.html">Contact</a></li>
          </ul>
        </div>
        
        <div class="footer-social">
          <h4>Suivez-nous</h4>
          <ul class="social-links">
            <% if (settings.socialMedia && settings.socialMedia.facebook) { %>
            <li><a href="<%= settings.socialMedia.facebook %>" target="_blank" rel="noopener">Facebook</a></li>
            <% } %>
            <% if (settings.socialMedia && settings.socialMedia.twitter) { %>
            <li><a href="<%= settings.socialMedia.twitter %>" target="_blank" rel="noopener">Twitter</a></li>
            <% } %>
            <% if (settings.socialMedia && settings.socialMedia.instagram) { %>
            <li><a href="<%= settings.socialMedia.instagram %>" target="_blank" rel="noopener">Instagram</a></li>
            <% } %>
            <% if (settings.socialMedia && settings.socialMedia.linkedin) { %>
            <li><a href="<%= settings.socialMedia.linkedin %>" target="_blank" rel="noopener">LinkedIn</a></li>
            <% } %>
          </ul>
        </div>
      </div>
      
      <div class="copyright">
        <p>&copy; <%= new Date().getFullYear() %> <%= settings.siteTitle %>. Tous droits réservés.</p>
        <p>Propulsé par MiniCMS</p>
      </div>
    </div>
  </footer>

  <!-- Scripts -->
  <script src="/assets/js/main.js"></script>
</body>
</html>